# ─── Supabase ────────────────────────────────────────────────────────────────
# Local: run `npx supabase start` (or `npx supabase status`) and copy the values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ─── Hosts ───────────────────────────────────────────────────────────────────
# Unknown hosts (localhost, Vercel preview URLs) show this ranch. Ignored in production.
DEFAULT_RANCH_SLUG=cottonwood-creek
# Optional: force "development" | "preview" | "production" (e.g. when running `next start` locally).
# APP_ENV=development

# ─── Later phases ────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# INQUIRY_FROM_ADDRESS="Ranch Website <inquiries@mail.elevartemis.com>"
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
